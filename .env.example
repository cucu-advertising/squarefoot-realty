# ---- Required in production ----
# Public site URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.squarefootrealty.in
# Long random string used to sign brochure download tokens. `openssl rand -hex 32`
BROCHURE_TOKEN_SECRET=

# ---- Lead delivery (at least one must succeed for a submission to be accepted) ----
# 1. Webhook / CRM endpoint that accepts a JSON POST (e.g. CRM, Zapier, Google Apps Script)
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=
# 2. Email via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEADS_EMAIL_TO=
LEADS_EMAIL_FROM=
# 3. Local append-only file (works on a VPS / Node server with a persistent disk; NOT on serverless)
LEADS_FILE_STORE=on
LEADS_FILE=./data/leads.jsonl

# ---- Public contact details (blocks are hidden until these are set; supply verified values only) ----
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_SITE_OFFICE_ADDRESS=
NEXT_PUBLIC_OFFICE_HOURS=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
