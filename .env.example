# ─────────────────────────────────────────────────────────────
# The Square — environment configuration
# Copy to .env.local (development) or set in your host's dashboard.
# NEVER commit real values. None of these are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Public canonical URL of the site (used for sitemap, OG tags, canonical links)
SITE_URL=https://www.example.com

# Who receives enquiries. Default comes from the brochure's contact block.
ENQUIRY_TO=info@irarealty.in
# Optional extra recipients, comma separated (e.g. a Squarefoot Realty inbox)
ENQUIRY_CC=

# A sender address on a domain you have VERIFIED with your provider.
# Visitor's email is set as Reply-To automatically.
ENQUIRY_FROM="The Square Website <enquiries@your-verified-domain.com>"

# Email provider: resend | smtp | console
#   resend  – uses RESEND_API_KEY (https://resend.com)
#   smtp    – uses SMTP_* (Google Workspace, Zoho, Amazon SES SMTP, etc.)
#   console – DEVELOPMENT ONLY: logs the enquiry to the server console.
#             Refused when NODE_ENV=production so a site can never show a
#             fake success state.
EMAIL_PROVIDER=console

RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Optional CRM / Google Sheets / Zapier webhook — receives every lead as JSON.
# If set together with an email provider, both must succeed.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Secret used to sign the brochure-access cookie. Use 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BROCHURE_TOKEN_SECRET=

# Optional: send a Google Analytics / GTM ID later — not wired by default.
